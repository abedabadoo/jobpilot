include LICENSE THIRD_PARTY_NOTICES.md README.md
include launcher.py requirements.lock requirements-runtime.lock pyproject.toml setup.py
include package.json package-lock.json .prettierrc.json
recursive-include web *.html *.css *.js
recursive-include remote_web *.html *.css *.js *.webmanifest *.svg *.png
recursive-include assets *.ico
recursive-include scripts *.py *.ps1 *.command
recursive-include extension *.json *.html *.css *.js *.cjs *.md
recursive-include docs *.md *.png
recursive-include tests *.py
recursive-include resumeforge *.py *.json *.ttf *.txt *.html *.css *.js *.sh *.ps1
include resumeforge/VENDORED_FROM
global-exclude __pycache__ *.py[cod]
